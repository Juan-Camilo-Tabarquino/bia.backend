   # Copy this file to .env:   cp .env.example .env
   # .env is git-ignored; this example file IS committed on purpose.

   # --- LLM provider ---------------------------------------------------------
   # WITHOUT LLM_API_KEY the backend falls back to a deterministic mock provider
   # that answers INSTANTLY. Fine for a smoke test, but it does not exercise the
   # real model: the "Correr análisis con IA" step would finish without showing
   # real work. Set it for the demo.
   LLM_API_KEY=
   LLM_BASE_URL=https://ollama.com
   LLM_MODEL=gpt-oss:20b

   # --- Data -----------------------------------------------------------------
   # Paths are relative to the repository root: start the server from there.
   READINGS_CSV=data/readings.csv
   EVENTS_CSV=data/events.csv

   # --- Demo login -----------------------------------------------------------
   # The single demo user lives in data/users.csv (username `jcamilo`, password
   # `bia2026`, name "Juan Camilo", authorized true). USERS_CSV overrides its path.
   USERS_CSV=data/users.csv
   # HS256 signing secret for the token issued by POST /api/auth/login. Optional:
   # while it is empty the handler falls back to a documented development secret
   # (bia-demo-only-jwt-secret-do-not-use-in-production), so the demo runs with no
   # configuration at all. Set it for anything that is not a local demo.
   JWT_SECRET=

   # --- Port -----------------------------------------------------------------
   # The HTTP port is NOT set from here. It comes from config.yaml (server.port,
   # default 3001). The SERVER_PORT line in config.go's header comment is stale:
   # there is no environment binding for it, and the default it mentions (8080) is
   # not the one the code uses.